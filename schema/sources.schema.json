{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sources.schema.json",
  "title": "sources.yml",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "title",
      "url",
      "license",
      "accessed",
      "kind"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "author": {
        "type": "string",
        "minLength": 1
      },
      "url": {
        "type": "string",
        "pattern": "^https?://\\S+$"
      },
      "license": {
        "type": "string",
        "minLength": 1
      },
      "accessed": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "kind": {
        "enum": [
          "docs",
          "oer",
          "wiki",
          "further-reading"
        ]
      },
      "topics": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^t(0[1-9]|1[0-3])$"
        },
        "uniqueItems": true
      },
      "refs": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
