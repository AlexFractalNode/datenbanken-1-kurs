{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exam.schema.json",
  "title": "exams/exam-NN.yml",
  "type": "object",
  "required": [
    "title",
    "minutes",
    "tasks"
  ],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "minutes": {
      "const": 90
    },
    "translation": {
      "const": "pending"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "topic",
          "status",
          "reviews",
          "type",
          "difficulty",
          "points",
          "minutes",
          "prompt",
          "solution",
          "rubric",
          "space"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^e0[1-9]-p\\d{3}$"
          },
          "topic": {
            "type": "string",
            "pattern": "^t(0[1-9]|1[0-3])$"
          },
          "status": {
            "enum": [
              "draft",
              "reviewed",
              "verified"
            ]
          },
          "reviews": {
            "type": "array",
            "items": {
              "enum": [
                "fach",
                "aufgaben",
                "leak",
                "en"
              ]
            },
            "uniqueItems": true
          },
          "sources": {
            "$ref": "#/$defs/sources"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "type": {
            "enum": [
              "define-example",
              "erm-model",
              "erm-read",
              "erm-to-sql",
              "normalize",
              "relalg",
              "sql-write",
              "sql-predict",
              "3vl",
              "explain"
            ]
          },
          "difficulty": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "points": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minutes": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "solution": {
            "type": "string",
            "minLength": 1
          },
          "rubric": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "criterion",
                "points"
              ],
              "additionalProperties": false,
              "properties": {
                "criterion": {
                  "type": "string",
                  "minLength": 1
                },
                "points": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          },
          "space": {
            "type": "string",
            "pattern": "^(lines:[1-9]\\d*|box:[1-9]\\d*|none)$"
          },
          "sql_ref": {
            "type": "string",
            "pattern": "^t(0[1-9]|1[0-3])-s\\d{3}$"
          }
        }
      }
    }
  },
  "$defs": {
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "ref"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
