---
/** Timed exam simulation (ExamRunner island) for one exam. */
import ExamRunner from '../../components/ExamRunner';
import Base from '../../layouts/Base.astro';
import { getExams } from '../../lib/content';
import { examProps } from '../../lib/island-props';
import { withBase } from '../../lib/nav';

/** Canonical pages use the exam id (`e01`); the file name (`exam-01`) redirects to it. */
export function getStaticPaths() {
  return getExams().flatMap((exam) => [{ params: { id: exam.id } }, { params: { id: exam.slug } }]);
}

const { id } = Astro.params;
const slugged = getExams().find((e) => e.slug === id);
if (slugged) return Astro.redirect(withBase(`klausur/${slugged.id}/`));
const exam = (await examProps()).find((e) => e.id === id);
if (!exam) throw new Error(`Unknown exam ${id}`);
---

<Base title={exam.title} description={`Klausur-Simulation: ${exam.title} (${exam.minutes} Minuten).`} noindex>
  <header class="page-head">
    <p class="eyebrow">
      <a href={withBase('klausur/')}>Klausur</a>
      <span aria-hidden="true">/</span>
      <span class="key">{exam.id}</span>
    </p>
    <h1>{exam.title}</h1>
  </header>
  <ExamRunner client:load exam={exam} />
  <noscript>
    <p class="notice notice--warn">Die Klausur-Simulation braucht JavaScript für Timer und Selbstbewertung.</p>
  </noscript>
</Base>
