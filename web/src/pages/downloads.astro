---
import Base from '../layouts/Base.astro';
import { getFurtherReading, getSources } from '../lib/content';
import { listDownloads, type DownloadGroup, type DownloadItem } from '../lib/downloads';
import { REPO_URL, withBase } from '../lib/nav';

const downloads = listDownloads();
const available = downloads.filter((d) => d.available);
const state = available.length > 0 ? 'ready' : 'empty';

const GROUPS: { id: DownloadGroup; title: string; compact: boolean }[] = [
  { id: 'anki', title: 'Anki', compact: false },
  { id: 'exam', title: 'Probeklausuren', compact: false },
  { id: 'material', title: 'Lernmaterial', compact: false },
  { id: 'anki-topic', title: 'Anki-Decks pro Thema', compact: true },
  { id: 'sheets', title: 'Aufgabenblätter pro Thema', compact: true },
];
const grouped = GROUPS.map((g) => ({ ...g, items: downloads.filter((d) => d.group === g.id) })).filter((g) => g.items.length > 0);

const furtherReading = getFurtherReading();
const usedSources = Object.values(getSources())
  .filter((s) => s.kind !== 'further-reading')
  .sort((a, b) => a.title.localeCompare(b.title, 'de'));

const href = (d: DownloadItem) => withBase(`downloads/${d.file}`);
---

<Base title="Downloads" description="Anki-Deck, Probeklausuren und Cheatsheet zum Herunterladen.">
  <header class="page-head">
    <h1>Downloads</h1>
    <p class="lead">Material zum Offline-Lernen: Anki-Decks, Probeklausuren mit Lösung, Cheatsheet und Aufgabenblätter.</p>
  </header>

  <div data-verify-unit="downloads" data-verify-state={state} data-verify-count={available.length}>
    {
      state === 'empty' && (
        <div class="notice notice--info" role="note">
          <p>
            In diesem Build liegen noch keine fertigen Dateien bei. Sie entstehen beim Veröffentlichen eines Releases und stehen dann
            hier und unter <a href={`${REPO_URL}/releases`}>Releases auf GitHub</a> bereit.
          </p>
        </div>
      )
    }
    {
      grouped.map((g) => (
        <section aria-labelledby={`dl-${g.id}`} class="download-group">
          <h2 id={`dl-${g.id}`}>{g.title}</h2>
          <ul class={g.compact ? 'download-list download-list--compact' : 'download-list'}>
            {g.items.map((d) => (
              <li class="card" data-file={d.file} data-available={d.available ? 'true' : 'false'}>
                <h3>{d.title}</h3>
                <p>{d.text}</p>
                {d.available ? (
                  <p>
                    <a class="button button--ghost" href={href(d)} download>
                      {d.file} herunterladen
                    </a>
                  </p>
                ) : (
                  <p class="meta">
                    <span class="badge">noch nicht verfügbar</span> Diese Datei liegt in diesem Build nicht bei. Du findest sie
                    bei den <a href={`${REPO_URL}/releases`}>Releases auf GitHub</a>, sobald ein Release veröffentlicht ist.
                  </p>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))
    }
    <p class="meta">
      Alle Versionen und Änderungen: <a href={`${REPO_URL}/releases`}>Releases auf GitHub</a>.
    </p>
  </div>

  {
    usedSources.length > 0 && (
      <section aria-labelledby="sources-heading">
        <h2 id="sources-heading">Verwendete Quellen</h2>
        <ul>
          {usedSources.map((s) => (
            <li>
              <a href={s.url} rel="noopener">
                {s.title}
              </a>
              {s.author && `, ${s.author}`} ({s.license}), abgerufen am {s.accessed}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    furtherReading.length > 0 && (
      <section aria-labelledby="reading-heading">
        <h2 id="reading-heading">Weiterführende Literatur</h2>
        <ul>
          {furtherReading.map((s) => (
            <li>
              <a href={s.url} rel="noopener">
                {s.title}
              </a>
              {s.author && `, ${s.author}`}
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
