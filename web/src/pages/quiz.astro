---
import Quiz from '../components/Quiz';
import Base from '../layouts/Base.astro';
import { quizProps } from '../lib/island-props';
import { withBase } from '../lib/nav';

const { items, topics } = await quizProps();
---

<Base title="Quiz" description="Quizfragen mit Sofort-Feedback." noindex>
  <header class="page-head">
    <h1>Quiz</h1>
    <p class="lead">Wähle deine Antwort und prüfe sie sofort. Zu jeder Antwort gibt es eine Erklärung, auch zu den falschen.</p>
  </header>
  <Quiz client:load items={items} topics={topics} />
  <noscript>
    <p class="notice notice--warn">
      Das Quiz braucht JavaScript. Ohne JavaScript übst du mit den <a href={withBase('aufgaben/')}>Papier-Aufgaben</a>.
    </p>
  </noscript>
</Base>
