---
import Glossary from '../components/Glossary';
import Base from '../layouts/Base.astro';
import { getGlossary, getTopics } from '../lib/content';
import { buildGlossaryItems } from '../lib/glossary';
import { withBase } from '../lib/nav';

const topics = getTopics();
const items = buildGlossaryItems(
  getGlossary(),
  new Set(topics.map((t) => t.id)),
  (id) => withBase(`themen/${id}/`),
);
---

<Base title="Glossar" description="Fachbegriffe der Datenbanken mit deutscher und englischer Bezeichnung.">
  <header class="page-head">
    <h1>Glossar</h1>
    <p class="lead">
      Fachbegriffe kurz erklärt – mit der englischen Bezeichnung, die dir in Dokumentationen begegnet. Jeder Eintrag hat einen
      eigenen Anker, Verweise wie „siehe …“ sind Links.
    </p>
  </header>

  <Glossary client:load items={items} topics={topics.map((t) => ({ id: t.id, title: t.title }))} />
</Base>
