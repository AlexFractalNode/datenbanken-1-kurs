{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glossary.schema.json",
  "title": "glossary.yml",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "de",
      "en",
      "keep_english",
      "def_de",
      "def_en"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^g-[a-z0-9-]+$"
      },
      "de": {
        "type": "string",
        "minLength": 1
      },
      "en": {
        "type": "string",
        "minLength": 1
      },
      "keep_english": {
        "type": "boolean"
      },
      "def_de": {
        "type": "string",
        "minLength": 1
      },
      "def_en": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
