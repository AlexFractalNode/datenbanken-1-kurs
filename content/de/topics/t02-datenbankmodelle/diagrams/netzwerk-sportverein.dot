// Netzwerkmodell am Beispiel desselben Sportvereins (Ausprägungen, kein ER-Diagramm).
// Ein Datensatz darf mit mehreren übergeordneten Datensätzen verknüpft sein: Jana wird nur einmal gespeichert.
// Die Pfeile sind gespeicherte Verweise, an denen ein Programm entlangnavigiert.
digraph netzwerk_sportverein {
  rankdir=TB;
  node [shape=box, fontsize=11];
  edge [fontsize=10];
  label="Netzwerkmodell: allgemeiner Graph aus Verweisen. Jana existiert einmal und ist mit zwei Mannschaften verknüpft.";
  labelloc=b;
  fontsize=11;

  verein     [label="Verein\nTSV Nordhang"];
  handball   [label="Abteilung\nHandball"];
  volleyball [label="Abteilung\nVolleyball"];
  hb_damen1  [label="Mannschaft\nHandball Damen 1"];
  vb_mixed   [label="Mannschaft\nVolleyball Mixed"];
  jana       [label="Spieler:in\nJana Ruf", color=blue];
  ida        [label="Spieler:in\nIda Kern"];
  timo       [label="Spieler:in\nTimo Brandt"];

  verein -> handball;
  verein -> volleyball;
  handball -> hb_damen1;
  volleyball -> vb_mixed;
  hb_damen1 -> jana;
  hb_damen1 -> ida;
  vb_mixed -> jana;
  vb_mixed -> timo;
}
