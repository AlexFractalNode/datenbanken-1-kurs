---
import Flashcards from '../components/Flashcards';
import Base from '../layouts/Base.astro';
import { flashcardProps } from '../lib/island-props';
import { withBase } from '../lib/nav';

const { cards, topics } = await flashcardProps();
---

<Base title="Karten" description="Karteikarten mit verteilter Wiederholung (FSRS)." noindex>
  <header class="page-head">
    <h1>Karteikarten</h1>
    <p class="lead">
      Lies die Frage, antworte im Kopf oder auf Papier und decke dann auf. Deine Einschätzung bestimmt, wann die Karte
      wiederkommt: Sichere Karten seltener, schwierige öfter.
    </p>
  </header>
  <Flashcards client:load cards={cards} topics={topics} />
  <noscript>
    <p class="notice notice--warn">
      Der Kartentrainer braucht JavaScript. Ohne JavaScript findest du die Inhalte in den
      <a href={withBase('themen/')}>Zusammenfassungen der Themen</a>.
    </p>
  </noscript>
</Base>
